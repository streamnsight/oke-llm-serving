  esac
done
if [[ "${command_words[*]}" == 'ce addon list --help' ]]; then
  printf 'Mock OCI add-on list help\n'
elif [[ "$repository" == ocid1.artifactrepository.oc1.test.* && "${command_words[*]}" == 'artifacts generic artifact list' ]]; then
  printf '{"data":{"items":[]}}\n'
elif [[ "$cluster" == ocid1.cluster.oc1.test.fixture && "${command_words[*]}" == 'ce addon list' ]]; then
  printf '{"data":[{"name":"NodeFeatureDiscovery","lifecycle-state":"ACTIVE"},{"name":"NvidiaGpuOperator","lifecycle-state":"ACTIVE"},{"name":"NvidiaNetworkOperator","lifecycle-state":"ACTIVE"},{"name":"GpuHealthMonitoring","lifecycle-state":"ACTIVE"}]}\n'

set -euo pipefail
if [[ "$*" == --version ]]; then printf 'fixture-version\n'; exit 0; fi
repository=""; cluster=""; command_words=()
while (( $# )); do
  case "$1" in
    --repository-id) repository=$2; shift 2;;
    --cluster-id) cluster=$2; shift 2;;
    --region|--output|--connection-timeout|--read-timeout|--compartment-id) shift 2;;
